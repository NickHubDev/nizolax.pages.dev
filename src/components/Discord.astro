---

const bots = [
  {
    name: "KITTY",
    image: "/discord/kitty_dark.jpg",
    url: "https://github.com/NickHubDev/KITTY-BOT",
  },
  {
    name: "OLVIDONES RP",
    image: "/discord/olvidones_rp_bot.jpg",
    url: "https://github.com/NickHubDev/OLVIDONES-RP",
  },
];

const servers = [
  {
    name: "OLVIDONES RP",
    image: "/discord/olvidones_rp_sin_fondo.png",
    url: "https://discord.gg/tu-invitacion",
  },
  {
    name: "DEV-KNIGHTS",
    image: "/logo_batman.jpg",
    url: "https://discord.gg/tu-devknights",
  },
];
---

  <section id="discord" class="discord reveal">
    <div class="header">
      <p class="tiny">COMMUNITY</p>
      <h1>DISCORD</h1>
      <p class="description">
        Bots personalizados y comunidades desarrolladas y gestionadas dentro de mi ecosistema.
      </p>
    </div>

    <!-- BOTS -->
    <div class="section">
      <h2 class="section-title">BOTS</h2>

      <div class="grid">
        {bots.map((bot) => (
          <a
            href={bot.url}
            target="_blank"
            rel="noopener noreferrer"
            class="profile"
            aria-label={bot.name}
          >
            <img src={bot.image} alt={bot.name} />
            <span>{bot.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- SERVIDORES -->
    <div class="section">
      <h2 class="section-title">SERVIDORES</h2>

      <div class="grid">
        {servers.map((server) => (
          <a
            href={server.url}
            target="_blank"
            rel="noopener noreferrer"
            class="profile"
            aria-label={server.name}
          >
            <img src={server.image} alt={server.name} />
            <span>{server.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

<style>
  .discord {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    font-family: "Cascadia Code", monospace;
  }

  .header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .tiny {
    color: #8b8b8b;
    letter-spacing: .25em;
    font-size: .85rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: "Press Start 2P", monospace;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #fff;
    margin: 0;
  }

  .description {
    color: #a3a3a3;
    max-width: 620px;
    margin: 1.2rem auto 0;
    line-height: 1.8;
  }

  .section {
    margin-top: 4rem;
  }

  .section-title {
    color: #fff;
    font-size: 1.2rem;
    letter-spacing: .18em;
    margin-bottom: 2rem;
    border-left: 3px solid #fff;
    padding-left: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 2rem;
    justify-items: center;
  }

  /* PERFIL */

  .profile {
    text-decoration: none;
    color: inherit;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .9rem;

    transition: .25s ease;
  }

  .profile:hover {
    transform: translateY(-6px);
  }

  .profile img {
    width: 150px;
    height: 150px;
    object-fit: cover;

    border: 1px solid #262626;
    background: #111;

    filter: grayscale(1) brightness(.9);
    transition: .3s ease;
  }

  .profile:hover img {
    filter: grayscale(0);
    border-color: #fff;
    box-shadow: 0 0 28px rgba(236,235,239,.18);
  }

  .profile span {
    color: #ececec;
    font-size: .95rem;
    text-align: center;
    letter-spacing: .05em;
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .profile img {
      width: 120px;
      height: 120px;
    }
  }
</style>