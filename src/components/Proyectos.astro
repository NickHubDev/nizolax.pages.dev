---

const projects = [
  {
    name: "KNIGHT-VIM",
    image: "/public/knight-vim.png",
    url: "https://github.com/NickHubDev/KNIGHTVIM",
  },
  {
    name: "DISCORD PORTAL",
    image: "/public/dev_portal.jpg",
    url: "",
  },
  {
    name: "KITTY-BOT",
    image: "/public/discord/kitty_dark.jpg",
    url: "https://github.com/NickHubDev/KITTY-BOT",
  },
];
---

  <section id="projects" class="projects reveal">
    <div class="header">
      <p class="tiny">WORK</p>
      <h1>PROYECTOS</h1>
      <p class="description">
        Algunos de los proyectos que he desarrollado enfocados en desarrollo de
        software, herramientas para developers y automatización.
      </p>
    </div>

    <div class="project-list">
      {projects.map((project) =>
        project.url ? (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
          >
            <article class="project-card">
              <div class="preview">
                <img src={project.image} alt={project.name} loading="lazy" />
              </div>

              <div class="content">
                <h2>{project.name}</h2>
              </div>
            </article>
          </a>
        ) : (
          <article class="project-card disabled">
            <div class="preview">
              <img src={project.image} alt={project.name} loading="lazy" />
            </div>

            <div class="content">
              <h2>{project.name}</h2>
              <span class="coming">COMING SOON</span>
            </div>
          </article>
        )
      )}
    </div>
  </section>

<style>
  .projects {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    font-family: "Cascadia Code", monospace;
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .tiny {
    color: #8b8b8b;
    letter-spacing: 0.25em;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: "Press Start 2P", monospace;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #fff;
    margin: 0;
  }

  .description {
    color: #a3a3a3;
    max-width: 620px;
    margin: 1.2rem auto 0;
    line-height: 1.8;
  }

  /* ---------- LISTA ---------- */

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .project-card {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 2rem;

    background: #111;
    border: 1px solid #262626;
    overflow: hidden;

    transition: 0.25s ease;
    cursor: pointer;
  }

  .disabled {
    cursor: default;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: #fff;
    box-shadow: 0 0 30px rgba(236, 235, 239, 0.18);
  }

  /* ---------- IMAGEN ---------- */

  .preview {
    height: 220px;
    background: #0a0a0a;
    overflow: hidden;
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    filter: grayscale(1) brightness(0.9);
    transition: 0.35s ease;
  }

  .project-card:hover .preview img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.03);
  }

  /* ---------- TEXTO ---------- */

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;
  }

  h2 {
    margin: 0;
    color: #fff;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .coming {
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
  }

  /* ---------- RESPONSIVE ---------- */

  @media (max-width: 900px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .preview {
      height: 200px;
    }

    h2 {
      font-size: 1.3rem;
    }

    .content {
      padding: 1.5rem;
    }
  }
</style>