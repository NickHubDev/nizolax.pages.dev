---
---

<section id="home" class="home reveal">
  <main class="hero">
    <div class="glass">
      <h1 class="title">NIZ00LAX</h1>

      <p class="tiny">
        Discord Developer especializado en bots escalables basados en
        <strong> TypeScript</strong>.
      </p>
    </div>
    <a href="#contact" class="cta">Solicitar presupuesto
    </a>
  </main>
</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=VT323&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Cascadia+Code:wght@200..700&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #111;
    color: #fff;
    font-family: "VT323", monospace;
  }

  /* ---------- CONTENEDOR ---------- */

  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    gap: 1.5rem;
  }

  /* ---------- HERO ---------- */

  .hero {
    flex: 1;
    width: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;

    text-align: center;
  }

  /* ---------- GLASS ---------- */

  .glass {
    width: min(900px, 100%);
    background: #181818;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3.2rem;

    box-shadow:
      0 0 0 1px #fff,
      0 0 20px rgba(255, 255, 255, 0.7);
  }

  .title {
    font-family: "Press Start 2P", monospace;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1.1;
  }

  .tiny {
    margin: 1.4rem 0 0;
    font-family: "Cascadia Code", monospace;
    color: #b8b8b8;
    font-size: 1rem;
    line-height: 1.8;
  }

  .tiny strong {
    color: #5c83c6;
    font-weight: 600;
  }

  /* ---------- BOTÓN CTA ---------- */

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 280px;
    padding: 1rem 2rem;

    background: #111;
    border: 1px solid #fff;

    color: #fff;
    text-decoration: none;

    font-family: "Cascadia Code", monospace;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cta:hover {
    background: #fff;
    color: #111;
    transform: translateY(-3px);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.35);
  }

  .cta:active {
    transform: translateY(-1px);
  }

  /* ---------- RESPONSIVE ---------- */

  @media (max-width: 900px) {
    .glass {
      padding: 2rem;
    }

    .title {
      font-size: 2.2rem;
    }

    .cta {
      width: 100%;
      max-width: 340px;
      min-width: unset;
      font-size: 0.9rem;
      padding: 0.95rem 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .home {
      padding: 1.25rem;
    }

    .glass {
      padding: 1.6rem;
    }

    .tiny {
      font-size: 0.92rem;
    }

    .cta {
      letter-spacing: 0.05em;
    }
  }
</style>