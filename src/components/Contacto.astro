<section id="contact" class="contact reveal">
  <!-- CABECERA -->
  <div class="header">
    <p class="tiny">SOCIAL</p>
    <h1>CONTACTO Y REDES</h1>
    <p class="description">
      Puedes encontrar mi contenido, contactar conmigo o solicitar el desarrollo
      de un proyecto personalizado.
    </p>
  </div>

  <!-- PANEL 1 · FORMULARIO -->
  <div class="panel form-panel">
    <div class="form-header">
      <p class="tiny-form">SERVICIOS</p>
      <h2>Solicitar presupuesto</h2>
      <p>
        Rellena el formulario y recibiré tu solicitud directamente en mi servidor
        de Discord.
      </p>
    </div>

    <form
      id="contactForm"
      class="contact-form"
      action="/api/contact"
      method="POST"
    >
      <div class="field">
        <label for="name">Nombre</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="40"
          placeholder="Nicolas Gracia"
        />
      </div>

      <div class="two-columns">
        <div class="field">
          <label for="email">Correo</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            maxlength="80"
            placeholder="correo@ejemplo.com"
          />
        </div>

        <div class="field">
          <label for="phone">Teléfono</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            maxlength="20"
            placeholder="+34 600 000 000"
          />
        </div>
      </div>

      <div class="field">
        <label for="message">Cuéntame tu proyecto</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="20"
          maxlength="1000"
          rows="6"
          placeholder="Necesito un bot de Discord con tickets, economía y dashboard..."
        ></textarea>
      </div>

      <button type="submit" class="submit-btn">
        ENVIAR SOLICITUD
      </button>

      <p id="status" class="status"></p>
    </form>
  </div>

  <!-- PANEL 2 · REDES -->
  <div class="panel social-panel">
    <div class="form-header">
      <p class="tiny-form">REDES</p>
      <h2>También puedes encontrarme aquí</h2>
      <p>
        Sígueme en redes o contacta directamente por correo o GitHub.
      </p>
    </div>

    <a
      href="https://www.tiktok.com/@nizolax_pro"
      target="_blank"
      rel="noopener noreferrer"
      class="row"
    >
      <div class="left">
        <span class="icon">♪</span>
        <div>
          <p class="label">TIKTOK</p>
          <h2>@NIZ00LAX</h2>
        </div>
      </div>
      <span class="arrow">↗</span>
    </a>

    <a
      href="https://youtube.com/@nizolax-pro"
      target="_blank"
      rel="noopener noreferrer"
      class="row"
    >
      <div class="left">
        <span class="icon">▶</span>
        <div>
          <p class="label">YOUTUBE</p>
          <h2>@NIZ00LAX</h2>
        </div>
      </div>
      <span class="arrow">↗</span>
    </a>

    <div class="bottom">
      <a href="mailto:nizolax.homehub@gmail.com" class="card">
        <p class="label">EMAIL</p>
        <h3>nizolax.homehub@gmail.com</h3>
      </a>

      <a
        href="https://github.com/NickHubDev"
        target="_blank"
        rel="noopener noreferrer"
        class="card"
      >
        <p class="label">GITHUB</p>
        <h3>NIZ00LAX</h3>
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactForm");
  const status = document.getElementById("status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    status.textContent = "Enviando solicitud...";
    status.style.color = "#888";

    const formData = new FormData(form);

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        status.textContent = "✓ Solicitud enviada correctamente.";
        status.style.color = "#8fffa6";
        form.reset();
      } else {
        status.textContent = data.error || "Ha ocurrido un error.";
        status.style.color = "#ff9a9a";
      }
    } catch {
      status.textContent = "No se pudo conectar con el servidor.";
      status.style.color = "#ff9a9a";
    }
  });
</script>

